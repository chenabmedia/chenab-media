# Next.js Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="chenabmedia-in.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="chenabmedia-in"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="chenabmedia-in.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-WML0K7N15T"

# Managed Email Dispatch & Webhook (Resend)
RESEND_API_KEY="re_123456789..."
RESEND_WEBHOOK_SECRET="whsec_..."

# Optional Distributed Rate Limiting (Upstash Redis REST - defaults to Firestore if omitted)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cloudflare R2 Object Storage (Server-Only, S3-Compatible)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="chenab-storage"
R2_PUBLIC_URL="https://assets.chenabmedia.in" # Optional, public CDN/custom domain for public assets

# GEMINI_API_KEY: Optional Gemini AI Key
GEMINI_API_KEY="MY_GEMINI_API_KEY"
